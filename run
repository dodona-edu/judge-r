#!/usr/bin/env Rscript

invisible(evalq({
    # We need to save the parent of the global environment before we load any
    # libraries. See context.R for a more extensive explanation.
    starting_parent_env <- parent.env(.GlobalEnv)

    # Compiling the judge's functions and those of the packages it uses costs more
    # than it saves, as they run only a few times per submission. Student code
    # keeps the level R started with: see .with_student_jit in context.R.
    student_jit_level <- compiler::enableJIT(0)

    library('jsonlite')
    library('base64enc')
    library('R6')
    # Attached like library() would, but a namespace only loads when one of its
    # functions is used: most submissions use neither.
    local(for (package in c('rlang', 'purrr')) {
        exports <- parseNamespaceFile(package, dirname(system.file(package = package)))$exports
        lazy <- attach(NULL, name = paste0('package:', package))
        for (name in exports) {
            eval(substitute(delayedAssign(name, getExportedValue(package, name), assign.env = lazy),
                            list(name = name, package = package)))
        }
    })

    input <- fromJSON(file('stdin'))
    source(paste(input$judge, 'judge.R', sep='/'), chdir=TRUE, local=TRUE)

    start_judgement(input$resources, input$source)
}, envir = new.env(parent = globalenv())))
